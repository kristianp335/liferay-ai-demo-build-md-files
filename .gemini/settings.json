{
  "context": {
    "fileName": [
      "WHO_YOU_ARE.md"
    ]
  },    
  "checkpointing": {
    "enabled": false  
  },
  "experimental": { 
    "enableAgents": true 
  },  
  "model": {
    "name": "gemini-3.8-flash"
  },
  //"model": {
  //  "name": "gemini-4-argon-preview"
  //},
  "agents": {
    "overrides": {
      "browser_agent": {
        "enabled": true
      }
    },
    "browser": {
      "sessionMode": "persistent",
      "visualModel": "gemini-2.5-computer-use-preview-10-2025",
      "allowedDomains": []
    }
  },
  "mcpServers": {
    "liferay-mcp": {
      "httpUrl": "$LIFERAY_MCP_URL",
      "headers": {
        "Authorization": "Basic $LIFERAY_MCP_BASIC_AUTH"
      }
    }
  }
}